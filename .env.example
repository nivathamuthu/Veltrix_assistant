# Copy to .env and add your own provider key. Never commit .env or real keys.

# --- Required by the assessment ------------------------------------------
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
# Today as YYYY-MM-DD. Leave empty to use the system date.
APP_TODAY=
# openai | anthropic | google
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Our own variables ----------------------------------------------------
# Chat model. Empty = the default model of the chosen provider.
LLM_MODEL=
# CPU embedding model.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Writable folder for the vector index (rebuilt at startup).
INDEX_DIR=./index
LOG_LEVEL=INFO
# Test/demo aid: artificial delay before ingestion finishes (seconds).
INGEST_STARTUP_DELAY_SECONDS=0
# Per-call LLM timeout and overall request budget (must stay under 30 s).
LLM_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=28
