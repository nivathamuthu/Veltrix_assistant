# Copy to .env and add your own provider key. Never commit .env or real keys.

# --- Required by the assessment ------------------------------------------
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db
# Today as YYYY-MM-DD. Leave empty to use the system date.
APP_TODAY=
# openai | anthropic | google
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Our own variables ----------------------------------------------------
# Chat model. Empty = the default model of the chosen provider.
LLM_MODEL=
# CPU embedding model.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Writable folder for the vector index (rebuilt at startup).
INDEX_DIR=./index
# Folder holding the embedding model. The Docker image downloads it at build
# time (to /opt/models) and loads it from there with no network access.
EMBED_CACHE_DIR=./models
# The image also sets TIKTOKEN_CACHE_DIR=/opt/tiktoken (token counting data,
# downloaded at build time) and HF_HUB_OFFLINE=1 (no model-hub access at runtime).
# For a non-Docker setup, run `python scripts/download_models.py` once.
LOG_LEVEL=INFO
# Test/demo aid: artificial delay before ingestion finishes (seconds).
INGEST_STARTUP_DELAY_SECONDS=0
# Per-call LLM timeout and overall request budget (must stay under 30 s).
LLM_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=28
# Minimum seconds between LLM HTTP calls (per process). 0 disables. Set 6–12 on Gemini free tier.
LLM_MIN_INTERVAL_SECONDS=0
# Host URL for `make live-smoke` (not read by the API).
LIVE_SMOKE_URL=http://127.0.0.1:8000
# How long live-smoke waits for GET /health 200 (ingestion is ~20s on the real corpus).
LIVE_SMOKE_HEALTH_WAIT_SECONDS=600
# Pause between live-smoke queries (free-tier per-minute limit). 0 or LIVE_SMOKE_NO_PAUSE=1 disables it.
LIVE_SMOKE_PAUSE_SECONDS=12
LIVE_SMOKE_NO_PAUSE=
